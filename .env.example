# Copy to .env.local for development.
# Required in production (Vercel project settings):
TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=<turso auth token>
AUTH_SECRET=<long random string, e.g. `openssl rand -hex 32`>

# Optional — email notifications (chapter submitted, feedback given, meeting
# scheduled, payment processed). Without RESEND_API_KEY, the app runs fine
# and logs "[email:skipped]" to the server console instead of sending.
# Get a free key at https://resend.com (3,000 emails/month free tier).
RESEND_API_KEY=<resend api key>
EMAIL_FROM="UG Thesis Management <onboarding@resend.dev>"
# Base URL used to build links inside emails (e.g. "Review chapter" button).
APP_URL=http://localhost:3000
